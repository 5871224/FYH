# 前端公開 API 設定範例
# 複製為 repo 根目錄 .env 後執行 npm run web:config

# 公開 API 網域（Cloudflare Tunnel 或 Nginx 反向代理後的 URL）
SUPABASE_URL=https://api.schedule.company.com
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_DOCUMENT_ID=default

# 前端靜態站網域（Supabase Auth Site URL 需一致）
PUBLIC_SITE_ORIGIN=https://schedule.company.com

# 修復 Supabase schema 用（Dashboard → Database → Connection string）
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
