      if (hireDate && leaveDate && !isValidDateRange(hireDate, leaveDate)) { reportValidationError("到職日必須早於離職日"); return; }
      const previousMember = mode === "edit" ? state.members.find((member) => member.id === modalContext.targetId) || null : null;
