# Nginx 反向代理範例（DMZ）
# 將 api.schedule.company.com 轉發到內網 Supabase Kong

upstream supabase_kong {
  server 10.0.0.50:8000;
  keepalive 32;
}

server {
  listen 443 ssl http2;
  server_name api.schedule.company.com;

  ssl_certificate     /etc/ssl/certs/api.schedule.company.com.crt;
  ssl_certificate_key /etc/ssl/private/api.schedule.company.com.key;

  client_max_body_size 20m;

  location / {
    proxy_pass http://supabase_kong;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 300s;
  }
}

server {
  listen 80;
  server_name api.schedule.company.com;
  return 301 https://$host$request_uri;
}
